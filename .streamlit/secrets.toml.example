# 复制为 .streamlit/secrets.toml 并填入真实值；该文件不要提交到 Git。
# 两项都有内置默认值，全部省略也能运行。

# weather.com 公共接口 key（实况 + 预报）。
# 若失效：打开页面
# https://weather.com/zh-CN/cn/guangxi/hezhou/fuchuan-yao-autonomous-county/postcode/542700/today
# 查看网页源码，搜索 api.weather.com 或 71f92ea9，把 32 位 key 填到下面。
TWC_KEY = "71f92ea9dd2f4790b92ea9dd2f779061"

# 可选：weather.com 坐标（默认富川县城附近）
TWC_GEOCODE = "24.897,111.324"
